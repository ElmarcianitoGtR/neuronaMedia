---
import type { IshikawaFactor } from '../lib/types';

interface Props {
  ishikawa: IshikawaFactor[];
  problema: string;
  causaRaiz?: string;
}

const { ishikawa = [], problema, causaRaiz } = Astro.props;

// Categorías superiores e inferiores de las 6M
const topCategories = [
  { key: 'Maquinaria', label: 'MAQUINARIA', xTip: 180, xSpine: 300, labelX: 110, labelY: 35 },
  { key: 'Método', label: 'MÉTODO', xTip: 420, xSpine: 540, labelX: 360, labelY: 35 },
  { key: 'Mano de Obra', label: 'MANO DE OBRA', xTip: 660, xSpine: 780, labelX: 590, labelY: 35 }
];

const bottomCategories = [
  { key: 'Materiales', label: 'MATERIALES', xTip: 180, xSpine: 300, labelX: 110, labelY: 535 },
  { key: 'Medición', label: 'MEDICIÓN', xTip: 420, xSpine: 540, labelX: 355, labelY: 535 },
  { key: 'Medio Ambiente', label: 'MEDIO AMBIENTE', xTip: 660, xSpine: 780, labelX: 585, labelY: 535 }
];

function getFactorsForCategory(catKey: string): IshikawaFactor[] {
  return ishikawa.filter((f) => f.categoria.toLowerCase() === catKey.toLowerCase());
}
---

<div class="bg-[#1f2937] border border-slate-700 p-4 md:p-6 rounded-sm space-y-4">
  
  <!-- BARRA DE TÍTULO Y CONTROLES -->
  <div class="flex flex-wrap justify-between items-center gap-3 border-b border-slate-700 pb-3">
    <div>
      <h3 class="text-xs font-bold uppercase text-slate-400 tracking-wider flex items-center gap-2">
        <span>DIAGRAMA DE ISHIKAWA (ESPINA DE PESCADO // CAUSA Y EFECTO)</span>
        <span class="px-2 py-0.5 text-[10px] bg-teal-900 text-teal-300 border border-teal-700 rounded-sm">6M INDUSTRIAL</span>
      </h3>
      <p class="text-xs text-slate-400 mt-1">
        Representación gráfica de las 6 categorías de causa que convergen hacia el efecto principal.
      </p>
    </div>

    <!-- BOTONES DE VISTA -->
    <div class="flex gap-2">
      <button
        id="btnViewFishbone"
        class="px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-sm bg-teal-600 text-white transition-none"
      >
        Vista Gráfica (Espina)
      </button>
      <button
        id="btnViewGrid"
        class="px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-sm bg-[#374151] text-slate-300 hover:bg-[#4b5563] transition-none"
      >
        Vista Matriz (6M)
      </button>
    </div>
  </div>

  <!-- VISTA 1: DIAGRAMA DE ESPINA DE PESCADO (SVG VECTORIAL MATTE) -->
  <div id="fishboneContainer" class="w-full overflow-x-auto bg-[#111827] border border-slate-700 p-4 rounded-sm">
    <div class="min-w-[980px]">
      <svg
        viewBox="0 0 1140 560"
        class="w-full h-auto select-none font-sans"
        xmlns="http://www.w3.org/2000/svg"
      >
        <defs>
          <!-- Flecha de la columna principal -->
          <marker id="main-arrow" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
            <path d="M 0 1 L 10 5 L 0 9 z" fill="#14b8a6" />
          </marker>

          <!-- Flecha de causas secundarias -->
          <marker id="sub-arrow" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 0 1 L 10 5 L 0 9 z" fill="#475569" />
          </marker>
        </defs>

        <!-- LÍNEA CENTRAL PRINCIPAL (COLUMNA VERTEBRAL) -->
        <line
          x1="40"
          y1="280"
          x2="910"
          y2="280"
          stroke="#14b8a6"
          stroke-width="5"
          stroke-linecap="round"
          marker-end="url(#main-arrow)"
        />

        <!-- CABEZA DEL PESCADO (EFECTO / PROBLEMA) -->
        <g transform="translate(930, 215)">
          <rect
            width="190"
            height="130"
            rx="3"
            ry="3"
            fill="#1f2937"
            stroke="#ef4444"
            stroke-width="2"
          />
          <!-- Encabezado de la cabeza -->
          <rect width="190" height="26" rx="2" ry="2" fill="#450a0a" />
          <text x="95" y="17" fill="#fca5a5" font-size="11" font-weight="bold" text-anchor="middle" letter-spacing="1">
            EFECTO / PROBLEMA
          </text>
          
          <!-- Descripción del problema -->
          <foreignObject x="10" y="32" width="170" height="90">
            <div xmlns="http://www.w3.org/1999/xhtml" class="text-[11px] text-slate-200 font-sans leading-tight pt-1">
              <span class="font-bold text-slate-100 line-clamp-4">
                {problema}
              </span>
            </div>
          </foreignObject>
        </g>

        <!-- ESPINAS SUPERIORES (TOP RIBS) -->
        {topCategories.map((cat, idx) => {
          const factors = getFactorsForCategory(cat.key);
          return (
            <g>
              <!-- Categoría Badge (Extremo Superior) -->
              <rect
                x={cat.labelX}
                y={cat.labelY - 20}
                width="140"
                height="28"
                rx="2"
                fill="#1f2937"
                stroke="#0d9488"
                stroke-width="1.5"
              />
              <text
                x={cat.labelX + 70}
                y={cat.labelY - 2}
                fill="#2dd4bf"
                font-size="11"
                font-weight="bold"
                text-anchor="middle"
                letter-spacing="1"
              >
                {cat.label}
              </text>

              <!-- Costilla Diagonal Superior -->
              <line
                x1={cat.xTip}
                y1={cat.labelY + 8}
                x2={cat.xSpine}
                y2="280"
                stroke="#334155"
                stroke-width="3"
                stroke-linecap="round"
              />

              <!-- Sub-espinas Horizontales con Factores -->
              {factors.map((fact, fIdx) => {
                // Cálculo de posición sobre la costilla diagonal
                const ratio = (fIdx + 1) / (factors.length + 1);
                const branchY = 50 + ratio * 200;
                const branchXOnRib = cat.xTip + ratio * (cat.xSpine - cat.xTip);
                const subLineLength = 110;
                const branchEndX = branchXOnRib - subLineLength;

                const isRoot = fact.esCausaRaiz;
                const strokeColor = isRoot ? '#ef4444' : '#475569';
                const boxBg = isRoot ? '#450a0a' : '#1f2937';
                const boxBorder = isRoot ? '#ef4444' : '#334155';
                const textColor = isRoot ? '#fecaca' : '#e2e8f0';

                return (
                  <g
                    class="cursor-pointer factor-node hover:opacity-90"
                    data-factor-id={fact.id}
                    data-factor-name={fact.factor}
                    data-factor-cat={fact.categoria}
                    data-factor-desc={fact.descripcion}
                    data-factor-impact={fact.impacto}
                    data-factor-root={isRoot ? 'true' : 'false'}
                  >
                    <!-- Línea horizontal de causa -->
                    <line
                      x1={branchEndX}
                      y1={branchY}
                      x2={branchXOnRib}
                      y2={branchY}
                      stroke={strokeColor}
                      stroke-width="1.5"
                      marker-end="url(#sub-arrow)"
                    />

                    <!-- Cajita de la Causa/Factor -->
                    <rect
                      x={branchEndX - 105}
                      y={branchY - 14}
                      width="105"
                      height="28"
                      rx="2"
                      fill={boxBg}
                      stroke={boxBorder}
                      stroke-width={isRoot ? '2' : '1'}
                    />
                    
                    <!-- Texto de la causa -->
                    <text
                      x={branchEndX - 52}
                      y={branchY + 3}
                      fill={textColor}
                      font-size="9.5"
                      font-weight={isRoot ? 'bold' : 'normal'}
                      text-anchor="middle"
                    >
                      {fact.factor.length > 15 ? fact.factor.substring(0, 14) + '…' : fact.factor}
                    </text>

                    {/* Estrella o indicador de Causa Raíz */}
                    {isRoot && (
                      <g transform={`translate(${branchEndX - 105}, ${branchY - 24})`}>
                        <rect width="52" height="12" rx="1" fill="#ef4444" />
                        <text x="26" y="9" fill="#ffffff" font-size="7.5" font-weight="bold" text-anchor="middle">
                          ★ CAUSA RAÍZ
                        </text>
                      </g>
                    )}
                  </g>
                );
              })}
            </g>
          );
        })}

        <!-- ESPINAS INFERIORES (BOTTOM RIBS) -->
        {bottomCategories.map((cat, idx) => {
          const factors = getFactorsForCategory(cat.key);
          return (
            <g>
              <!-- Categoría Badge (Extremo Inferior) -->
              <rect
                x={cat.labelX}
                y={cat.labelY - 10}
                width="140"
                height="28"
                rx="2"
                fill="#1f2937"
                stroke="#0d9488"
                stroke-width="1.5"
              />
              <text
                x={cat.labelX + 70}
                y={cat.labelY + 8}
                fill="#2dd4bf"
                font-size="11"
                font-weight="bold"
                text-anchor="middle"
                letter-spacing="1"
              >
                {cat.label}
              </text>

              <!-- Costilla Diagonal Inferior -->
              <line
                x1={cat.xTip}
                y1={cat.labelY - 10}
                x2={cat.xSpine}
                y2="280"
                stroke="#334155"
                stroke-width="3"
                stroke-linecap="round"
              />

              <!-- Sub-espinas Horizontales con Factores -->
              {factors.map((fact, fIdx) => {
                const ratio = (fIdx + 1) / (factors.length + 1);
                const branchY = 510 - ratio * 200;
                const branchXOnRib = cat.xTip + ratio * (cat.xSpine - cat.xTip);
                const subLineLength = 110;
                const branchEndX = branchXOnRib - subLineLength;

                const isRoot = fact.esCausaRaiz;
                const strokeColor = isRoot ? '#ef4444' : '#475569';
                const boxBg = isRoot ? '#450a0a' : '#1f2937';
                const boxBorder = isRoot ? '#ef4444' : '#334155';
                const textColor = isRoot ? '#fecaca' : '#e2e8f0';

                return (
                  <g
                    class="cursor-pointer factor-node hover:opacity-90"
                    data-factor-id={fact.id}
                    data-factor-name={fact.factor}
                    data-factor-cat={fact.categoria}
                    data-factor-desc={fact.descripcion}
                    data-factor-impact={fact.impacto}
                    data-factor-root={isRoot ? 'true' : 'false'}
                  >
                    <!-- Línea horizontal de causa -->
                    <line
                      x1={branchEndX}
                      y1={branchY}
                      x2={branchXOnRib}
                      y2={branchY}
                      stroke={strokeColor}
                      stroke-width="1.5"
                      marker-end="url(#sub-arrow)"
                    />

                    <!-- Cajita de la Causa/Factor -->
                    <rect
                      x={branchEndX - 105}
                      y={branchY - 14}
                      width="105"
                      height="28"
                      rx="2"
                      fill={boxBg}
                      stroke={boxBorder}
                      stroke-width={isRoot ? '2' : '1'}
                    />
                    
                    <!-- Texto de la causa -->
                    <text
                      x={branchEndX - 52}
                      y={branchY + 3}
                      fill={textColor}
                      font-size="9.5"
                      font-weight={isRoot ? 'bold' : 'normal'}
                      text-anchor="middle"
                    >
                      {fact.factor.length > 15 ? fact.factor.substring(0, 14) + '…' : fact.factor}
                    </text>

                    {/* Estrella o indicador de Causa Raíz */}
                    {isRoot && (
                      <g transform={`translate(${branchEndX - 105}, ${branchY + 18})`}>
                        <rect width="52" height="12" rx="1" fill="#ef4444" />
                        <text x="26" y="9" fill="#ffffff" font-size="7.5" font-weight="bold" text-anchor="middle">
                          ★ CAUSA RAÍZ
                        </text>
                      </g>
                    )}
                  </g>
                );
              })}
            </g>
          );
        })}

      </svg>
    </div>
  </div>

  <!-- PANEL DE INSPECCIÓN INTERACTIVA (MUESTRA DETALLE AL HACER CLIC EN UN NODO) -->
  <div id="inspectorPanel" class="bg-[#111827] border border-slate-700 p-4 rounded-sm flex flex-wrap justify-between items-center gap-4">
    <div class="space-y-1">
      <div class="flex items-center gap-2">
        <span class="text-xs uppercase font-bold text-teal-400">Factor Seleccionado:</span>
        <span id="inspName" class="text-sm font-bold text-slate-100">
          {ishikawa.find(f => f.esCausaRaiz)?.factor || ishikawa[0]?.factor || 'Selecciona un factor en la espina'}
        </span>
        <span id="inspBadge" class="px-2 py-0.5 text-[10px] font-bold uppercase rounded-sm bg-red-900 text-red-300">
          ★ Causa Raíz Primaria
        </span>
      </div>
      <p id="inspDesc" class="text-xs text-slate-300">
        {ishikawa.find(f => f.esCausaRaiz)?.descripcion || ishikawa[0]?.descripcion || 'Haz clic sobre cualquier caja del diagrama de espina para inspeccionar el diagnóstico detallado.'}
      </p>
    </div>

    <div class="flex items-center gap-4 text-xs font-mono text-slate-400">
      <div>Categoría: <span id="inspCat" class="text-teal-400 font-bold">{ishikawa.find(f => f.esCausaRaiz)?.categoria || 'Maquinaria'}</span></div>
      <div>Impacto: <span id="inspImpact" class="text-red-400 font-bold">{ishikawa.find(f => f.esCausaRaiz)?.impacto || 'Alto'}</span></div>
    </div>
  </div>

  <!-- VISTA 2: MATRIZ DE CUADRANTES 6M (ALTERNATIVA TABULAR) -->
  <div id="matrixContainer" class="hidden grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
    {[...topCategories, ...bottomCategories].map((cat) => {
      const factors = getFactorsForCategory(cat.key);
      return (
        <div class="bg-[#111827] border border-slate-700 p-3 rounded-sm space-y-2">
          <div class="flex justify-between items-center border-b border-slate-700 pb-1">
            <span class="text-xs font-bold uppercase text-teal-400">{cat.label}</span>
            <span class="text-xs font-mono text-slate-400">({factors.length})</span>
          </div>
          {factors.length === 0 ? (
            <div class="text-xs text-slate-500 italic py-1">Sin anomalías registradas</div>
          ) : (
            factors.map((fact) => (
              <div class={`p-2 rounded-sm border text-xs ${
                fact.esCausaRaiz
                  ? 'bg-[#450a0a] border-[#991b1b] text-red-200'
                  : 'bg-[#1f2937] border-slate-700 text-slate-300'
              }`}>
                <div class="flex justify-between items-center font-bold">
                  <span>{fact.factor}</span>
                  <span class={`text-[10px] uppercase font-mono ${
                    fact.impacto === 'Alto' ? 'text-red-400' : fact.impacto === 'Medio' ? 'text-yellow-400' : 'text-slate-400'
                  }`}>
                    {fact.impacto}
                  </span>
                </div>
                <p class="text-slate-400 mt-1 leading-snug">{fact.descripcion}</p>
                {fact.esCausaRaiz && (
                  <div class="mt-1 text-[10px] font-bold text-red-400 uppercase tracking-wider">
                    ★ Identificado como Causa Raíz
                  </div>
                )}
              </div>
            ))
          )}
        </div>
      );
    })}
  </div>

</div>

<script>
  const btnFishbone = document.getElementById('btnViewFishbone');
  const btnGrid = document.getElementById('btnViewGrid');
  const fishboneContainer = document.getElementById('fishboneContainer');
  const matrixContainer = document.getElementById('matrixContainer');

  if (btnFishbone && btnGrid && fishboneContainer && matrixContainer) {
    btnFishbone.addEventListener('click', () => {
      fishboneContainer.classList.remove('hidden');
      matrixContainer.classList.add('hidden');
      btnFishbone.className = 'px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-sm bg-teal-600 text-white transition-none';
      btnGrid.className = 'px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-sm bg-[#374151] text-slate-300 hover:bg-[#4b5563] transition-none';
    });

    btnGrid.addEventListener('click', () => {
      fishboneContainer.classList.add('hidden');
      matrixContainer.classList.remove('hidden');
      btnGrid.className = 'px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-sm bg-teal-600 text-white transition-none';
      btnFishbone.className = 'px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-sm bg-[#374151] text-slate-300 hover:bg-[#4b5563] transition-none';
    });
  }

  // Interacción al hacer clic en un nodo de factor de la espina
  const nodes = document.querySelectorAll('.factor-node');
  const inspName = document.getElementById('inspName');
  const inspDesc = document.getElementById('inspDesc');
  const inspCat = document.getElementById('inspCat');
  const inspImpact = document.getElementById('inspImpact');
  const inspBadge = document.getElementById('inspBadge');

  nodes.forEach(node => {
    node.addEventListener('click', () => {
      const name = node.getAttribute('data-factor-name');
      const desc = node.getAttribute('data-factor-desc');
      const cat = node.getAttribute('data-factor-cat');
      const impact = node.getAttribute('data-factor-impact');
      const isRoot = node.getAttribute('data-factor-root') === 'true';

      if (inspName) inspName.textContent = name || '';
      if (inspDesc) inspDesc.textContent = desc || '';
      if (inspCat) inspCat.textContent = cat || '';
      if (inspImpact) inspImpact.textContent = impact || '';

      if (inspBadge) {
        if (isRoot) {
          inspBadge.className = 'px-2 py-0.5 text-[10px] font-bold uppercase rounded-sm bg-red-900 text-red-300';
          inspBadge.textContent = '★ Causa Raíz Primaria';
          inspBadge.classList.remove('hidden');
        } else {
          inspBadge.className = 'px-2 py-0.5 text-[10px] font-bold uppercase rounded-sm bg-[#374151] text-slate-300';
          inspBadge.textContent = `Impacto: ${impact}`;
        }
      }
    });
  });
</script>
