---
import { getIncidentes } from '../lib/memgraph';

// Código que corre en el servidor Node de Astro antes de renderizar
const incidentes = await getIncidentes();
---

<html lang="es">
<head>
  <meta charset="utf-8" />
  <title>Quality Hub - Control de Calidad</title>
</head>
<body class="p-8 font-sans bg-slate-50 text-slate-900">
  <h1 class="text-3xl font-bold">Consola de Incidencias de Calidad</h1>
  <p class="text-slate-600 mb-6">Auditoría 8D, Ishikawa y 5 Porqués (Humano en el Bucle)</p>

  <div class="grid gap-4">
    {incidentes.map((inc: any) => (
      <div class="border p-4 rounded-lg bg-white shadow-sm">
        <h2 class="font-bold text-lg">{inc.id} - {inc.descripcion}</h2>
        <p class="text-sm text-slate-500">Causa Raíz Propuesta: {inc.causaRaiz}</p>
        <div class="mt-3 flex gap-2">
          <a href={`/reportes/${inc.id}`} class="bg-blue-600 text-white px-3 py-1 rounded text-sm">
            Revisar y Validar
          </a>
          <a href={`/api/generate-pdf?id=${inc.id}`} target="_blank" class="bg-slate-700 text-white px-3 py-1 rounded text-sm">
            Descargar PDF Oficial
          </a>
        </div>
      </div>
    ))}
  </div>
</body>
</html>
